<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Microsoft.Coyote packages are consumed from the timonkrebs/coyote fork
         (upgraded to .NET 10 and able to control System.Threading.Lock), which
         has no public feed yet; run eng/build-coyote-packages.sh to pack them
         from source (pinned commit) into this local feed. CI does this before
         restoring. -->
    <add key="coyote-local" value="packages/coyote" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="coyote-local">
      <package pattern="Microsoft.Coyote*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
